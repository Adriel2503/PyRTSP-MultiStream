# -*- coding: utf-8 -*-
"""
Diálogo avanzado de configuración de overlays
Interfaz profesional con configuración global y elementos en pantalla
"""

import datetime
from PyQt6.QtWidgets import (
    QDialog, QVBoxLayout, QHBoxLayout, QLabel, QPushButton, 
    QGroupBox, QGridLayout, QFrame, QSlider, QSpinBox,
    QColorDialog, QCheckBox, QWidget, QScrollArea
)
from PyQt6.QtCore import Qt, pyqtSignal, QTimer
from PyQt6.QtGui import QFont, QColor

from ..utils.logger import setup_logger

logger = setup_logger("OverlayConfigDialog")

class ToggleSwitch(QCheckBox):
    """Switch toggle personalizado con estilo iOS"""
    
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setFixedSize(50, 25)
        self.setStyleSheet("""
        QCheckBox {
            border: none;
            outline: none;
        }
        QCheckBox::indicator {
            width: 50px;
            height: 25px;
            border-radius: 12px;
            background-color: #555555;
            border: 2px solid #333333;
        }
        QCheckBox::indicator:checked {
            background-color: #4CAF50;
            border: 2px solid #45a049;
        }
        QCheckBox::indicator:checked:after {
            content: "";
            width: 19px;
            height: 19px;
            border-radius: 9px;
            background-color: white;
            margin: 1px;
            position: absolute;
            right: 2px;
        }
        QCheckBox::indicator:unchecked:after {
            content: "";
            width: 19px;
            height: 19px;
            border-radius: 9px;
            background-color: white;
            margin: 1px;
            position: absolute;
            left: 2px;
        }
        """)

class ColorButton(QPushButton):
    """Botón selector de color personalizado"""
    
    color_changed = pyqtSignal(QColor)
    
    def __init__(self, initial_color=QColor(255, 167, 38), parent=None):
        super().__init__(parent)
        self.current_color = initial_color
        self.setFixedSize(40, 30)
        self.update_style()
        self.clicked.connect(self.choose_color)
    
    def update_style(self):
        """Actualizar el estilo del botón con el color actual"""
        rgb = f"rgb({self.current_color.red()}, {self.current_color.green()}, {self.current_color.blue()})"
        hex_color = self.current_color.name()
        self.setStyleSheet(f"""
        QPushButton {{
            background-color: {rgb};
            border: 2px solid #ffffff;
            border-radius: 6px;
        }}
        QPushButton:hover {{
            border: 2px solid #FFA726;
        }}
        """)
        self.setToolTip(f"Color: {hex_color.upper()}")
    
    def choose_color(self):
        """Abrir diálogo de selección de color"""
        color = QColorDialog.getColor(self.current_color, self, "Seleccionar Color")
        if color.isValid():
            self.current_color = color
            self.update_style()
            self.color_changed.emit(color)
    
    def get_color(self):
        """Obtener color actual"""
        return self.current_color
    
    def set_color(self, color):
        """Establecer color"""
        self.current_color = color
        self.update_style()

class OverlayConfigDialog(QDialog):
    """Diálogo avanzado para configurar overlays con interfaz profesional"""
    
    # Señal emitida cuando se cambia la configuración
    overlay_config_changed = pyqtSignal(dict)
    
    def __init__(self, parent=None, current_config=None):
        super().__init__(parent)
        self.current_config = current_config or {}
        self.setup_ui()
        self.load_current_config()
        
        # Timer para actualizar fecha/hora
        self.datetime_timer = QTimer()
        self.datetime_timer.timeout.connect(self.update_datetime)
        self.datetime_timer.start(1000)  # Actualizar cada segundo
        
        logger.info("Diálogo avanzado de configuración de overlays inicializado")
    
    def setup_ui(self):
        """Configurar la interfaz avanzada del diálogo"""
        self.setWindowTitle("⚙️ Configuración de Overlays")
        self.setModal(True)
        self.setFixedSize(520, 750)
        
        # Layout principal
        main_layout = QVBoxLayout(self)
        main_layout.setContentsMargins(15, 15, 15, 15)
        main_layout.setSpacing(10)
        

        
        # Área de scroll
        scroll_area = QScrollArea()
        scroll_widget = QWidget()
        scroll_layout = QVBoxLayout(scroll_widget)
        
        # === CONFIGURACIÓN GLOBAL ===
        global_group = self.create_global_config_group()
        scroll_layout.addWidget(global_group)
        
        # === ELEMENTOS EN PANTALLA ===
        elements_group = self.create_elements_group()
        scroll_layout.addWidget(elements_group)
        
        scroll_area.setWidget(scroll_widget)
        scroll_area.setWidgetResizable(True)
        scroll_area.setStyleSheet("""
        QScrollArea {
            border: none;
            background: transparent;
        }
        """)
        main_layout.addWidget(scroll_area)
        
        # === BOTONES ===
        buttons_layout = QHBoxLayout()
        buttons_layout.setSpacing(15)
        
        # Botón Cancelar
        cancel_button = QPushButton("❌ Cancelar")
        cancel_button.setFixedSize(120, 40)
        cancel_button.clicked.connect(self.reject)
        cancel_button.setStyleSheet("""
        QPushButton {
            background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #6c757d, stop:1 #545b62);
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            font-size: 12px;
        }
        QPushButton:hover {
            background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #757575, stop:1 #616161);
        }
        """)
        
        # Botón Aplicar
        apply_button = QPushButton("✅ Aplicar Cambios")
        apply_button.setFixedSize(150, 40)
        apply_button.clicked.connect(self.apply_config)
        apply_button.setStyleSheet("""
        QPushButton {
            background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #FFB74D, stop:1 #FFA726);
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            font-size: 12px;
        }
        QPushButton:hover {
            background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #FFA726, stop:1 #FF9800);
        }
        """)
        
        buttons_layout.addWidget(cancel_button)
        buttons_layout.addStretch()
        buttons_layout.addWidget(apply_button)
        main_layout.addLayout(buttons_layout)
        
        # Aplicar estilo general
        self.setStyleSheet("""
        QDialog {
            background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #2c3e50, stop:1 #34495e);
        }
        """)
    
    def create_global_config_group(self):
        """Crear grupo de configuración global"""
        group = QGroupBox("🛠️ Configuración Global")
        group.setStyleSheet("""
        QGroupBox {
            font-weight: bold;
            font-size: 13px;
            color: #4CAF50;
            border: 2px solid rgba(76, 175, 80, 100);
            border-radius: 10px;
            margin-top: 15px;
            padding-top: 15px;
        }
        QGroupBox::title {
            subcontrol-origin: margin;
            left: 15px;
            padding: 0 10px 0 10px;
            color: #4CAF50;
        }
        """)
        
        layout = QGridLayout(group)
        layout.setContentsMargins(15, 20, 15, 15)
        layout.setSpacing(12)
        
        # Fecha y Hora (display)
        layout.addWidget(QLabel("Fecha y Hora"), 0, 0)
        self.datetime_label = QLabel("2025/06/24  14:13:19")
        self.datetime_label.setStyleSheet("""
        QLabel {
            background: #34495e;
            color: white;
            padding: 8px;
            border-radius: 6px;
            font-family: 'Courier New', monospace;
            font-weight: bold;
        }
        """)
        layout.addWidget(self.datetime_label, 0, 1, 1, 2)
        
        # Constante
        layout.addWidget(QLabel("Constante"), 1, 0)
        self.constant_spinbox = QSpinBox()
        self.constant_spinbox.setRange(1, 100)
        self.constant_spinbox.setValue(10)
        self.constant_spinbox.setStyleSheet("""
        QSpinBox {
            background: #34495e;
            color: white;
            padding: 8px;
            border: 2px solid #555555;
            border-radius: 6px;
            font-weight: bold;
        }
        QSpinBox:focus {
            border: 2px solid #FFA726;
        }
        """)
        layout.addWidget(self.constant_spinbox, 1, 1)
        
        # Tamaño de Fuente
        layout.addWidget(QLabel("Tamaño de Fuente"), 2, 0)
        self.font_size_slider = QSlider(Qt.Orientation.Horizontal)
        self.font_size_slider.setRange(16, 48)
        self.font_size_slider.setValue(32)
        self.font_size_slider.setStyleSheet(self.get_slider_style())
        self.font_size_label = QLabel("32px")
        self.font_size_label.setStyleSheet("color: #FFA726; font-weight: bold;")
        self.font_size_slider.valueChanged.connect(lambda v: self.font_size_label.setText(f"{v}px"))
        layout.addWidget(self.font_size_slider, 2, 1)
        layout.addWidget(self.font_size_label, 2, 2)
        
        # Opacidad del Fondo
        layout.addWidget(QLabel("Opacidad del Fondo"), 3, 0)
        self.bg_opacity_slider = QSlider(Qt.Orientation.Horizontal)
        self.bg_opacity_slider.setRange(0, 100)
        self.bg_opacity_slider.setValue(60)
        self.bg_opacity_slider.setStyleSheet(self.get_slider_style())
        self.bg_opacity_label = QLabel("0.6")
        self.bg_opacity_label.setStyleSheet("color: #FFA726; font-weight: bold;")
        self.bg_opacity_slider.valueChanged.connect(lambda v: self.bg_opacity_label.setText(f"{v/100:.1f}"))
        layout.addWidget(self.bg_opacity_slider, 3, 1)
        layout.addWidget(self.bg_opacity_label, 3, 2)
        
        # Opacidad Cuadrículas
        layout.addWidget(QLabel("Opacidad Cuadrículas"), 4, 0)
        self.grid_opacity_slider = QSlider(Qt.Orientation.Horizontal)
        self.grid_opacity_slider.setRange(0, 100)
        self.grid_opacity_slider.setValue(80)
        self.grid_opacity_slider.setStyleSheet(self.get_slider_style())
        self.grid_opacity_label = QLabel("0.8")
        self.grid_opacity_label.setStyleSheet("color: #FFA726; font-weight: bold;")
        self.grid_opacity_slider.valueChanged.connect(lambda v: self.grid_opacity_label.setText(f"{v/100:.1f}"))
        layout.addWidget(self.grid_opacity_slider, 4, 1)
        layout.addWidget(self.grid_opacity_label, 4, 2)
        
        # Colores
        layout.addWidget(QLabel("Color de Fondo"), 5, 0)
        self.bg_color_button = ColorButton(QColor(26, 26, 26))  # #1a1a1a
        self.bg_color_hex = QLabel("#1a1a1a")
        self.bg_color_hex.setStyleSheet("color: #1a1a1a; background: white; padding: 5px; border-radius: 4px; font-weight: bold; font-family: 'Courier New';")
        self.bg_color_button.color_changed.connect(lambda c: self.bg_color_hex.setText(c.name().upper()))
        layout.addWidget(self.bg_color_button, 5, 1)
        layout.addWidget(self.bg_color_hex, 5, 2)
        
        layout.addWidget(QLabel("Color de Texto"), 6, 0)
        self.text_color_button = ColorButton(QColor(255, 255, 255))  # #ffffff
        self.text_color_hex = QLabel("#ffffff")
        self.text_color_hex.setStyleSheet("color: white; background: black; padding: 5px; border-radius: 4px; font-weight: bold; font-family: 'Courier New';")
        self.text_color_button.color_changed.connect(lambda c: self.text_color_hex.setText(c.name().upper()))
        layout.addWidget(self.text_color_button, 6, 1)
        layout.addWidget(self.text_color_hex, 6, 2)
        
        layout.addWidget(QLabel("Color de Cuadrícula"), 7, 0)
        self.grid_color_button = ColorButton(QColor(176, 33, 33))  # #b02121
        self.grid_color_hex = QLabel("#b02121")
        self.grid_color_hex.setStyleSheet("color: #b02121; background: white; padding: 5px; border-radius: 4px; font-weight: bold; font-family: 'Courier New';")
        self.grid_color_button.color_changed.connect(lambda c: self.grid_color_hex.setText(c.name().upper()))
        layout.addWidget(self.grid_color_button, 7, 1)
        layout.addWidget(self.grid_color_hex, 7, 2)
        
        # Estilo para las etiquetas
        for i in range(layout.rowCount()):
            label = layout.itemAtPosition(i, 0)
            if label and isinstance(label.widget(), QLabel):
                label.widget().setStyleSheet("""
                QLabel {
                    color: white;
                    font-weight: bold;
                    font-size: 11px;
                }
                """)
        
        return group
    
    def create_elements_group(self):
        """Crear grupo de elementos en pantalla"""
        group = QGroupBox("🎛️ Elementos en Pantalla")
        group.setStyleSheet("""
        QGroupBox {
            font-weight: bold;
            font-size: 13px;
            color: #FF9800;
            border: 2px solid rgba(255, 152, 0, 100);
            border-radius: 10px;
            margin-top: 15px;
            padding-top: 15px;
        }
        QGroupBox::title {
            subcontrol-origin: margin;
            left: 15px;
            padding: 0 10px 0 10px;
            color: #FF9800;
        }
        """)
        
        layout = QGridLayout(group)
        layout.setContentsMargins(15, 20, 15, 15)
        layout.setSpacing(15)
        
        # Crear toggles para cada elemento
        elements = [
            ("Fecha y Hora", "fecha_enabled"),
            ("Referencia Tramo", "tramo_enabled"),
            ("Pozo Desde", "pozo_inicial_enabled"),
            ("Pozo Hasta", "pozo_final_enabled"),
            ("Cuadrículas", "grid_enabled"),
            ("Distancia", "distancia_enabled")
        ]
        
        self.element_toggles = {}
        
        for i, (name, key) in enumerate(elements):
            row = i // 2
            col = i % 2
            
            # Container para cada elemento
            element_widget = QWidget()
            element_layout = QHBoxLayout(element_widget)
            element_layout.setContentsMargins(10, 8, 10, 8)
            element_layout.setSpacing(10)
            
            # Icono indicador de estado
            status_icon = QLabel("●")
            status_icon.setFixedSize(20, 20)
            status_icon.setAlignment(Qt.AlignmentFlag.AlignCenter)
            status_icon.setStyleSheet("""
            QLabel {
                color: #4CAF50;
                font-size: 16px;
                font-weight: bold;
                border-radius: 10px;
                background: rgba(76, 175, 80, 30);
            }
            """)
            
            # Etiqueta del elemento
            label = QLabel(name)
            label.setStyleSheet("""
            QLabel {
                color: white;
                font-size: 11px;
                font-weight: bold;
            }
            """)
            
            # Toggle switch
            toggle = ToggleSwitch()
            toggle.setChecked(True)  # Por defecto habilitado
            
            # Conectar toggle con icono de estado
            def update_status(checked, icon=status_icon):
                if checked:
                    icon.setStyleSheet("""
                    QLabel {
                        color: #4CAF50;
                        font-size: 16px;
                        font-weight: bold;
                        border-radius: 10px;
                        background: rgba(76, 175, 80, 30);
                    }
                    """)
                else:
                    icon.setStyleSheet("""
                    QLabel {
                        color: #757575;
                        font-size: 16px;
                        font-weight: bold;
                        border-radius: 10px;
                        background: rgba(117, 117, 117, 30);
                    }
                    """)
            
            toggle.toggled.connect(update_status)
            
            element_layout.addWidget(status_icon)
            element_layout.addWidget(label)
            element_layout.addStretch()
            element_layout.addWidget(toggle)
            
            # Estilo del container
            element_widget.setStyleSheet("""
            QWidget {
                background: rgba(255, 255, 255, 10);
                border: 1px solid rgba(255, 255, 255, 30);
                border-radius: 8px;
            }
            QWidget:hover {
                background: rgba(255, 167, 38, 20);
                border: 1px solid rgba(255, 167, 38, 60);
            }
            """)
            
            layout.addWidget(element_widget, row, col)
            self.element_toggles[key] = toggle
        
        return group
    
    def get_slider_style(self):
        """Obtener estilo para sliders"""
        return """
        QSlider::groove:horizontal {
            background: #555555;
            height: 8px;
            border-radius: 4px;
        }
        QSlider::handle:horizontal {
            background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #FFA726, stop:1 #FF9800);
            border: 2px solid #FF9800;
            width: 18px;
            margin: -5px 0;
            border-radius: 9px;
        }
        QSlider::handle:horizontal:hover {
            background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #FFB74D, stop:1 #FFA726);
        }
        QSlider::sub-page:horizontal {
            background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #FFA726, stop:1 #FF9800);
            border-radius: 4px;
        }
        """
    
    def update_datetime(self):
        """Actualizar display de fecha y hora"""
        now = datetime.datetime.now()
        formatted = now.strftime("%Y / %m / %d    %H : %M : %S")
        self.datetime_label.setText(formatted)
    
    def load_current_config(self):
        """Cargar configuración actual"""
        if not self.current_config:
            return
        
        # Cargar estados de elementos
        for key, toggle in self.element_toggles.items():
            toggle.setChecked(self.current_config.get(key, True))
    
    def apply_config(self):
        """Aplicar configuración"""
        config = {}
        
        # Recopilar configuración de elementos
        for key, toggle in self.element_toggles.items():
            config[key] = toggle.isChecked()
        
        # Recopilar configuración global (para futura implementación)
        config['font_size'] = self.font_size_slider.value()
        config['bg_opacity'] = self.bg_opacity_slider.value() / 100.0
        config['grid_opacity'] = self.grid_opacity_slider.value() / 100.0
        config['constant'] = self.constant_spinbox.value()
        config['bg_color'] = self.bg_color_button.get_color().name()
        config['text_color'] = self.text_color_button.get_color().name()
        config['grid_color'] = self.grid_color_button.get_color().name()
        
        logger.info(f"Aplicando configuración: {config}")
        self.overlay_config_changed.emit(config)
        self.accept()
    
    def closeEvent(self, event):
        """Limpiar al cerrar"""
        if hasattr(self, 'datetime_timer'):
            self.datetime_timer.stop()
        super().closeEvent(event) 